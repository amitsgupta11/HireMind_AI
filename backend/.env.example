# ---- Server ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ---- Database ----
# Local Docker Postgres:
DATABASE_URL=postgresql://hiremind:hiremind@localhost:5432/hiremind_dev
# Hosted (Render Postgres / Neon / Supabase) usually needs sslmode=require:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- Redis / Queue ----
# Local Docker Redis:
REDIS_URL=redis://localhost:6379
# Hosted (recommended: Upstash — has a free tier and works well with
# BullMQ + Render): use the rediss:// (TLS) URL Upstash gives you, e.g.
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# ---- File Storage (Cloudinary) ----
# Leave blank in local dev to use the local-disk DEV FALLBACK.
# Required before deploying (web + worker run on separate machines and
# can't share a local disk) — get these from cloudinary.com/console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- AI Service ----
# Required for Phase 6 (resume parsing). Without it, the worker fails
# resume jobs honestly at the ANALYZING stage instead of faking results.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
